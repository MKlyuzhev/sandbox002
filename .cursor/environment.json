{
  "name": "Local RAG Server",
  "user": "ubuntu",
  "install": "bash scripts/cloud-agent-install.sh",
  "start": "bash scripts/cloud-agent-start.sh",
  "terminals": [
    {
      "name": "rag-api",
      "command": ".venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000"
    },
    {
      "name": "dashboard",
      "command": ".venv/bin/python -m dashboard"
    }
  ],
  "ports": [8000, 8001]
}
